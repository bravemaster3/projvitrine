# Copy to `.env` at the repository root and fill in.
# Lines without a value fall back to the defaults noted beside them.

# --- Backend -------------------------------------------------------------------
DEBUG=false                       # true for local development
SECRET_KEY=                       # required when DEBUG=false; long random string
JWT_SIGNING_KEY=                  # optional, defaults to SECRET_KEY
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

ALLOWED_HOSTS=                    # default: derived from SITE_URL
CSRF_TRUSTED_ORIGINS=             # default: derived from SITE_URL
CORS_ALLOWED_ORIGINS=             # only needed when the frontend is on another origin
SITE_URL=https://projvitrine.kndev.org
SECURE_COOKIES=true               # default: true unless DEBUG
LOG_LEVEL=INFO
GUNICORN_WORKERS=2

# Database: either DATABASE_URL ...
DATABASE_URL=                     # e.g. postgres://user:pass@db:5432/projvitrine
# ... or the DB_* variables (used by docker-compose-prod.yaml). Neither = SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# GitHub OAuth app (login). Its callback URL must point at SITE_URL.
# The old SOCIAL_AUTH_GITHUB_KEY / SOCIAL_AUTH_GITHUB_SECRET names still work.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LANGS=en,fr,sv                    # languages offered (first = default)

# --- Web container (read at start-up; no rebuild needed) -----------------------
VITE_GITHUB_CLIENT_ID=            # same value as GITHUB_CLIENT_ID (falls back to it)
VITE_BRAND_NAME=ProjVitrine
VITE_SOURCE_URL=                  # optional footer link to the source code
VITE_API_URL=                     # empty = same origin as the site (recommended)

# --- Web container -------------------------------------------------------------
CANONICAL_HOST=                   # e.g. projvitrine.kndev.org; other host names 301 here
