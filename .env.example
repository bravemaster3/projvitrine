# Copy to `.env` (local / droplet) or paste into Coolify's Environment
# Variables (Developer view). Same order as the old droplet .env, so you can fill
# it from that file. Write values without quotes. Empty lines fall back to the
# defaults described above them. Comments are kept on their own lines on purpose:
# some tools would otherwise treat "  # ..." as part of the value.

# FRONTEND ENV VARS
# Public address of the site. VITE_FRONTEND_URL is the old name for SITE_URL;
# set both to the same value (SITE_URL wins if they differ).
VITE_FRONTEND_URL=https://projvitrine.kndev.org
# GitHub OAuth app client id (public). Falls back to SOCIAL_AUTH_GITHUB_KEY.
VITE_GITHUB_CLIENT_ID=

# Django secret key (required in production; keep the droplet's value)
SECRET_KEY=

# GitHub OAuth credentials (old names; GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
# also work). The app's callback URL must be SITE_URL with a trailing slash.
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=

# JWT signing key (optional, defaults to SECRET_KEY; keep the droplet's value)
JWT_SIGNING_KEY=

# DEBUG: False in production, True for local development
DEBUG=False

# SITE DOMAIN: domain without scheme or port (localhost:8000 in development)
SITE_DOMAIN=projvitrine.kndev.org

# DATABASE
# In Coolify these also create the database on first start; settle them before
# the first deploy and do not change them afterwards.
DB_NAME=
DB_USER=
DB_PASSWORD=
# 'db' for docker-compose-prod.yaml; ignored on Coolify (fixed to projvitrine-db)
DB_HOST=db
DB_PORT=5432
# Alternative to the DB_* lines: a full URL, e.g. postgres://user:pass@host:5432/name
# Leave everything empty locally to use SQLite.
DATABASE_URL=


# --- New in ProjVitrine --------------------------------------------------------
# Full public URL of the site; used for links, previews and allowed hosts.
SITE_URL=https://projvitrine.kndev.org
# Every other host name (e.g. alxhof.kndev.org) 301-redirects to this one.
CANONICAL_HOST=projvitrine.kndev.org

# --- Optional (the defaults are fine) ------------------------------------------
# Name shown in the site and browser tab
VITE_BRAND_NAME=ProjVitrine
# Languages offered; the first is the default
LANGS=en,fr,sv
# Footer link to the source code; empty hides it
VITE_SOURCE_URL=https://github.com/bravemaster3/projvitrine
# API location; empty = same origin as the site (recommended)
VITE_API_URL=
# Login session lengths
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Defaults derived from SITE_URL; set only for unusual setups
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Only when the frontend runs on a different origin than the API
CORS_ALLOWED_ORIGINS=
# Secure cookies; default true unless DEBUG
SECURE_COOKIES=
LOG_LEVEL=INFO
GUNICORN_WORKERS=2

# No longer used (safe to delete): NODE_ENV, VITE_BACKEND_URL, VITE_MEDIA_URL
